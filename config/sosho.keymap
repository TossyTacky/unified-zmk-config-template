//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp ESC    &kp Q    &kp W  &kp E  &kp R       &kp T      &kp Y      &kp U       &kp I      &kp O    &kp P       &kp MINUS
            &kp LCTRL  &lt 3 A  &kp S  &kp D  &kp F       &kp G      &kp H      &kp J       &kp K      &kp L    &lt 3 SEMI  &kp EQUAL
            &kp LSHFT  &kp Z    &kp X  &kp C  &kp V       &kp B      &kp N      &kp M       &kp COMMA  &kp DOT  &kp SLASH   &kp RSHFT
            &kp LALT   &kp LGUI               &lt 1 SPACE &lt 2 TAB  &lt 2 BSPC &lt 1 ENTER                     &kp APOS    &kp CAPSLOCK
        >;
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

    layer_1 {
        bindings = <
            &kp ESC   &kp Q    &kp W    &kp UP   &kp J     &kp I     &kp KP_COMMA &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS       &kp KP_MINUS
            &kp LCTRL &lt 3 A  &kp LEFT &kp DOWN &kp RIGHT &kp COLON &kp KP_DOT   &kp KP_N4 &kp KP_N5 &kp KP_N6 &lt 3 KP_MULTIPLY &kp KP_EQUAL
            &kp LSHFT &kp Z    &kp X    &kp C    &kp V     &kp L     &kp KP_N0    &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DIVIDE     &kp RSHFT
            &kp LALT  &kp LGUI                   &kp SPACE &lt 2 TAB &lt 2 BSPC   &kp ENTER                     &kp BSLH          &kp KP_NUMLOCK
        >;
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

    layer_2 {
        bindings = <
            &kp ESC   &kp RSHFT N1 &kp RSHFT N2 &kp RSHFT N3 &kp RSHFT N4 &kp RSHFT N5 &kp LSHFT N6 &LSHFT N7 &kp LSHFT N8 &kp RSHFT N9 &kp RSHFT N0     &kp MINUS
            &kp LCTRL &lt 3 N1     &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7    &kp N8       &kp N9       &lt 3 N0         &kp EQUAL
            &kp LSHFT &none        &kp PIPE     &kp BSLH     &kp LBKT     &kp RBKT     &kp APOS     &kp SQT   &kp DQT      &LSHFT LBKT  &kp LSHFT RBKT   &kp RSHFT
            &kp LALT  &kp                                    &kp SPACE    &kp TAB      &kp BSPC     &kp ENTER                           &kp GRAVE        &none
        >;
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

    //    layer_2 {
    //     bindings = <
    //         &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &trans  &trans    &kp MINUS &kp EQUAL &trans     &trans
    //         &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &kp LBKT  &kp RBKT  &kp NUBS  &trans     &trans
    //         &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &trans  &kp SEMI  &kp SQT   &trans    &kp QMARK  &kp BSLH
    //         &trans &trans                  &trans  &trans     &trans  &trans                        &trans     &trans
    //     >;
		// sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    // };

    layer_3 {
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &trans         &trans
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans      &trans  &out OUT_BLE                                    &trans         &trans
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
