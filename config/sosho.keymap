//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/{
  behaviors {
    ec_ms_l: ec_ms_h {
      compatible = "zmk,behavior-encoder-mouse-scroll";
      #sensor-binding-cells = <2>;
    };
    ec_ms_r: ec_ms_v {
      compatible = "zmk,behavior-encoder-mouse-scroll";
      #sensor-binding-cells = <2>;
    };
  };
};

//スクロールの調整
&msc {
  // time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）Default
  time-to-max-speed-ms = <500>;   // 500ms 低速度
  // acceleration-exponent = <0>;   // 加速なし Default
  acceleration-exponent = <2>;   // 直線加速 linier acceleration
};

/{
  combos {
    compatible = "zmk,combos";
	//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	  combo_LCLK {
      // timeout-ms = <50>; // Default
      timeout-ms = <150>;
      key-positions = <19 20>;
      bindings = <&mkp LCLK>;
    };

	  //右クリックのコンボ 20 K 21 L
    combo_RCLK {
      // timeout-ms = <50>; // Default
      timeout-ms = <150>;
      key-positions = <20 21>;
      bindings = <&mkp RCLK>;
    };

	  //ホイールクリックのコンボ 19 J 21 L
	  combo_MCLK {
      // timeout-ms = <90>; // Default
      timeout-ms = <200>;
      key-positions = <19 21>;
      bindings = <&mkp MCLK>;
    };
  };
};

/{
  keymap {
    compatible = "zmk,keymap";
    default_layer {
      bindings = <
        &kp ESC    &kp Q    &kp W  &kp E  &kp R       &kp T      &kp Y      &kp U       &kp I      &kp O    &kp P       &kp MINUS
        &kp LCTRL  &lt 3 A  &kp S  &kp D  &kp F       &kp G      &kp H      &kp J       &kp K      &kp L    &lt 3 SEMI  &kp EQUAL
        &kp LSHFT  &kp Z    &kp X  &kp C  &kp V       &kp B      &kp N      &kp M       &kp COMMA  &kp DOT  &kp SLASH   &kp RSHFT
        &kp LALT   &kp LGUI               &lt 1 SPACE &lt 2 TAB  &lt 2 BSPC &lt 1 ENTER                     &kp APOS    &kp GRAVE
      >;
      sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
    layer_1 {
      bindings = <
        &kp ESC   &kp Q    &kp W    &kp UP   &kp J     &kp I     &kp COMMA    &kp N7    &kp N8 &kp N9 &kp PLUS          &kp MINUS
        &kp LCTRL &lt 3 A  &kp LEFT &kp DOWN &kp RIGHT &kp COLON &kp DOT      &kp N4    &kp N5 &kp N6 &lt 3 KP_MULTIPLY &kp EQUAL
        &kp LSHFT &kp Z    &kp X    &kp C    &kp V     &kp L     &kp N0       &kp N1    &kp N2 &kp N3 &kp SLASH         &kp RSHFT
        &kp LALT  &kp LGUI                   &kp SPACE &lt 2 TAB &lt 2 BSPC   &kp ENTER               &kp BSLH          &to 0
      >;
      sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
    layer_2 {
      bindings = <
        &kp ESC   &kp EXCL  &kp AT   &kp HASH &kp DLLR  &kp PRCNT &kp CARET &kp AMPS  &kp STAR  &kp LPAR &kp RPAR  &kp F12
        &kp LCTRL &lt 3 F1  &kp F2   &kp F3   &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp N9   &lt 3 F10 &kp F11
        &kp LSHFT &kp GRAVE &kp BSLH &kp PIPE &kp LBKT  &kp RBKT  &kp SQT   &kp DQT   &kp LBRC  &kp RBRC &kp TILDE &kp RSHFT
        &kp LALT  &kp LGUI                    &kp SPACE &kp TAB   &kp BSPC  &kp ENTER                    &none     &to 0
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
    layer_3 {
      bindings = <
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_SEL 5  &none        &none         &none  &none &none &to 0
        &sys_reset   &none        &none        &bt BT_CLR_ALL &bt BT_CLR     &bt BT_SEL 0  &to 0        &to 1         &to 2  &none &none &sys_reset
        &kt CAPSLOCK &none        &none        &none          &none          &none         &none        &none         &none  &none &none &kt CAPSLOCK 
        &none        &none                                    &kp RC(LEFT)   &kp RC(RIGHT) &kp LC(LEFT) &kp LC(RIGHT)              &none &out OUT_BLE
      >;
    };
    scroll {
        status = "reserved";
    };
    extra2 {
        status = "reserved";
    };
  };
};

